>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. GENSTMT.
*> Build a statement extract from the final master and interest file.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ACCT-IN-FILE ASSIGN TO "accounts.final.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-ACCT-IN-STATUS.
    SELECT INT-IN-FILE ASSIGN TO "interest.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-INT-IN-STATUS.
    SELECT STMT-OUT-FILE ASSIGN TO "statements.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-STMT-OUT-STATUS.

DATA DIVISION.
FILE SECTION.
FD ACCT-IN-FILE.
COPY ACCTREC.

FD INT-IN-FILE.
COPY INTREC.

FD STMT-OUT-FILE.
COPY STMTREC.

WORKING-STORAGE SECTION.
01 WS-FILE-STATUS.
    05 WS-ACCT-IN-STATUS         PIC X(02).
    05 WS-INT-IN-STATUS          PIC X(02).
    05 WS-STMT-OUT-STATUS        PIC X(02).

01 WS-FLAGS.
    05 WS-ACCT-EOF              PIC X VALUE "N".
        88 ACCT-EOF            VALUE "Y".
    05 WS-INT-EOF               PIC X VALUE "N".
        88 INT-EOF             VALUE "Y".
    05 WS-INT-FOUND             PIC X VALUE "N".
        88 INT-FOUND           VALUE "Y".

01 WS-RUN-DATE                  PIC 9(08).

01 WS-INTEREST-TABLE.
    05 WS-INT-COUNT             PIC 9(04) VALUE 0.
    05 WS-INT-ITEM OCCURS 200 TIMES INDEXED BY INT-IDX.
        10 WS-INT-BYTES         PIC X(22).

PROCEDURE DIVISION.
MAIN-PROCEDURE.
    ACCEPT WS-RUN-DATE FROM DATE YYYYMMDD
    PERFORM LOAD-INTEREST
    OPEN INPUT ACCT-IN-FILE
    IF WS-ACCT-IN-STATUS NOT = "00"
        DISPLAY "GENSTMT: cannot open accounts.final.dat status="
            WS-ACCT-IN-STATUS
        STOP RUN
    END-IF
    OPEN OUTPUT STMT-OUT-FILE
    IF WS-STMT-OUT-STATUS NOT = "00"
        DISPLAY "GENSTMT: cannot open statements.dat status="
            WS-STMT-OUT-STATUS
        STOP RUN
    END-IF
    PERFORM UNTIL ACCT-EOF
        READ ACCT-IN-FILE
            AT END
                SET ACCT-EOF TO TRUE
            NOT AT END
                PERFORM WRITE-STATEMENT
        END-READ
    END-PERFORM
    CLOSE ACCT-IN-FILE
    CLOSE STMT-OUT-FILE
    STOP RUN.

LOAD-INTEREST.
    OPEN INPUT INT-IN-FILE
    IF WS-INT-IN-STATUS NOT = "00"
        DISPLAY "GENSTMT: cannot open interest.dat status="
            WS-INT-IN-STATUS
        STOP RUN
    END-IF
    PERFORM UNTIL INT-EOF
        READ INT-IN-FILE
            AT END
                SET INT-EOF TO TRUE
            NOT AT END
                ADD 1 TO WS-INT-COUNT
                IF WS-INT-COUNT > 200
                    DISPLAY "GENSTMT: interest table overflow"
                    STOP RUN
                END-IF
                SET INT-IDX TO WS-INT-COUNT
                MOVE INTEREST-RECORD TO WS-INT-BYTES(INT-IDX)
        END-READ
    END-PERFORM
    CLOSE INT-IN-FILE.

WRITE-STATEMENT.
    MOVE ACCT-ID TO STMT-ACCT-ID
    MOVE ACCT-NAME TO STMT-NAME
    MOVE ACCT-TYPE TO STMT-TYPE
    MOVE ACCT-STATUS TO STMT-STATUS
    MOVE ACCT-BALANCE TO STMT-BALANCE
    MOVE WS-RUN-DATE TO STMT-DATE
    MOVE 0 TO STMT-INTEREST
    PERFORM FIND-INTEREST
    IF INT-FOUND
        MOVE WS-INT-BYTES(INT-IDX) TO INTEREST-RECORD
        MOVE INT-AMOUNT TO STMT-INTEREST
    END-IF
    WRITE STATEMENT-RECORD.

FIND-INTEREST.
    MOVE "N" TO WS-INT-FOUND
    PERFORM VARYING INT-IDX FROM 1 BY 1
        UNTIL INT-IDX > WS-INT-COUNT
        IF WS-INT-BYTES(INT-IDX)(1:10) = ACCT-ID
            SET INT-FOUND TO TRUE
            EXIT PERFORM
        END-IF
    END-PERFORM.
