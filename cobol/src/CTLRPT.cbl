>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. CTLRPT.
*> Prove the cycle: opening + credits - debits + interest = final.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ACCT-IN-FILE ASSIGN TO "accounts.in.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-ACCT-IN-STATUS.
    SELECT JRN-IN-FILE ASSIGN TO "journal.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-JRN-IN-STATUS.
    SELECT EXC-IN-FILE ASSIGN TO "exceptions.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-EXC-IN-STATUS.
    SELECT INT-IN-FILE ASSIGN TO "interest.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-INT-IN-STATUS.
    SELECT ACCT-FINAL-FILE ASSIGN TO "accounts.final.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-ACCT-FINAL-STATUS.
    SELECT CTL-OUT-FILE ASSIGN TO "control.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-CTL-OUT-STATUS.

DATA DIVISION.
FILE SECTION.
FD ACCT-IN-FILE.
COPY ACCTREC.

FD JRN-IN-FILE.
COPY JRNREC.

FD EXC-IN-FILE.
COPY EXCREC.

FD INT-IN-FILE.
COPY INTREC.

FD ACCT-FINAL-FILE.
    01 ACCT-FINAL-RECORD         PIC X(61).

FD CTL-OUT-FILE.
COPY CTLREC.

WORKING-STORAGE SECTION.
01 WS-FILE-STATUS.
    05 WS-ACCT-IN-STATUS         PIC X(02).
    05 WS-JRN-IN-STATUS         PIC X(02).
    05 WS-EXC-IN-STATUS         PIC X(02).
    05 WS-INT-IN-STATUS         PIC X(02).
    05 WS-ACCT-FINAL-STATUS     PIC X(02).
    05 WS-CTL-OUT-STATUS        PIC X(02).

01 WS-FLAGS.
    05 WS-ACCT-EOF              PIC X VALUE "N".
        88 ACCT-EOF            VALUE "Y".
    05 WS-JRN-EOF               PIC X VALUE "N".
        88 JRN-EOF             VALUE "Y".
    05 WS-EXC-EOF               PIC X VALUE "N".
        88 EXC-EOF             VALUE "Y".
    05 WS-INT-EOF               PIC X VALUE "N".
        88 INT-EOF             VALUE "Y".
    05 WS-FINAL-EOF             PIC X VALUE "N".
        88 FINAL-EOF           VALUE "Y".

01 WS-COUNTS.
    05 WS-ACCOUNT-COUNT         PIC 9(06) VALUE 0.
    05 WS-JOURNAL-COUNT        PIC 9(06) VALUE 0.
    05 WS-EXCEPTION-COUNT      PIC 9(06) VALUE 0.
    05 WS-INTEREST-COUNT       PIC 9(06) VALUE 0.

01 WS-TOTALS.
    05 WS-OPENING               PIC S9(13)V99 SIGN IS LEADING SEPARATE
                                VALUE 0.
    05 WS-CREDITS               PIC S9(13)V99 SIGN IS LEADING SEPARATE
                                VALUE 0.
    05 WS-DEBITS                PIC S9(13)V99 SIGN IS LEADING SEPARATE
                                VALUE 0.
    05 WS-INTEREST              PIC S9(13)V99 SIGN IS LEADING SEPARATE
                                VALUE 0.
    05 WS-FINAL                PIC S9(13)V99 SIGN IS LEADING SEPARATE
                                VALUE 0.
    05 WS-EXPECTED              PIC S9(13)V99 SIGN IS LEADING SEPARATE
                                VALUE 0.

PROCEDURE DIVISION.
MAIN-PROCEDURE.
    PERFORM SUM-OPENING
    PERFORM SUM-JOURNAL
    PERFORM COUNT-EXCEPTIONS
    PERFORM SUM-INTEREST
    PERFORM SUM-FINAL
    PERFORM WRITE-CONTROL
    IF CTL-OUT-OF-BAL
        DISPLAY "CTLRPT: OUT OF BALANCE expected=" WS-EXPECTED
            " final=" WS-FINAL
        MOVE 8 TO RETURN-CODE
    ELSE
        DISPLAY "CTLRPT: BALANCED"
    END-IF
    STOP RUN.

SUM-OPENING.
    OPEN INPUT ACCT-IN-FILE
    IF WS-ACCT-IN-STATUS NOT = "00"
        DISPLAY "CTLRPT: cannot open accounts.in.dat status="
            WS-ACCT-IN-STATUS
        STOP RUN
    END-IF
    PERFORM UNTIL ACCT-EOF
        READ ACCT-IN-FILE
            AT END
                SET ACCT-EOF TO TRUE
            NOT AT END
                ADD 1 TO WS-ACCOUNT-COUNT
                ADD ACCT-BALANCE TO WS-OPENING
        END-READ
    END-PERFORM
    CLOSE ACCT-IN-FILE.

SUM-JOURNAL.
    OPEN INPUT JRN-IN-FILE
    IF WS-JRN-IN-STATUS NOT = "00"
        DISPLAY "CTLRPT: cannot open journal.dat status="
            WS-JRN-IN-STATUS
        STOP RUN
    END-IF
    PERFORM UNTIL JRN-EOF
        READ JRN-IN-FILE
            AT END
                SET JRN-EOF TO TRUE
            NOT AT END
                ADD 1 TO WS-JOURNAL-COUNT
                IF JRN-CREDIT
                    ADD JRN-AMOUNT TO WS-CREDITS
                ELSE
                    IF JRN-DEBIT
                        ADD JRN-AMOUNT TO WS-DEBITS
                    END-IF
                END-IF
        END-READ
    END-PERFORM
    CLOSE JRN-IN-FILE.

COUNT-EXCEPTIONS.
    OPEN INPUT EXC-IN-FILE
    IF WS-EXC-IN-STATUS NOT = "00"
        DISPLAY "CTLRPT: cannot open exceptions.dat status="
            WS-EXC-IN-STATUS
        STOP RUN
    END-IF
    PERFORM UNTIL EXC-EOF
        READ EXC-IN-FILE
            AT END
                SET EXC-EOF TO TRUE
            NOT AT END
                ADD 1 TO WS-EXCEPTION-COUNT
        END-READ
    END-PERFORM
    CLOSE EXC-IN-FILE.

SUM-INTEREST.
    OPEN INPUT INT-IN-FILE
    IF WS-INT-IN-STATUS NOT = "00"
        DISPLAY "CTLRPT: cannot open interest.dat status="
            WS-INT-IN-STATUS
        STOP RUN
    END-IF
    PERFORM UNTIL INT-EOF
        READ INT-IN-FILE
            AT END
                SET INT-EOF TO TRUE
            NOT AT END
                ADD 1 TO WS-INTEREST-COUNT
                ADD INT-AMOUNT TO WS-INTEREST
        END-READ
    END-PERFORM
    CLOSE INT-IN-FILE.

SUM-FINAL.
    OPEN INPUT ACCT-FINAL-FILE
    IF WS-ACCT-FINAL-STATUS NOT = "00"
        DISPLAY "CTLRPT: cannot open accounts.final.dat status="
            WS-ACCT-FINAL-STATUS
        STOP RUN
    END-IF
    PERFORM UNTIL FINAL-EOF
        READ ACCT-FINAL-FILE
            AT END
                SET FINAL-EOF TO TRUE
            NOT AT END
                MOVE ACCT-FINAL-RECORD TO ACCOUNT-RECORD
                ADD ACCT-BALANCE TO WS-FINAL
        END-READ
    END-PERFORM
    CLOSE ACCT-FINAL-FILE.

WRITE-CONTROL.
    COMPUTE WS-EXPECTED = WS-OPENING + WS-CREDITS - WS-DEBITS + WS-INTEREST
    MOVE WS-ACCOUNT-COUNT TO CTL-ACCOUNTS
    MOVE WS-JOURNAL-COUNT TO CTL-JOURNAL
    MOVE WS-EXCEPTION-COUNT TO CTL-EXCEPTIONS
    MOVE WS-INTEREST-COUNT TO CTL-INTEREST-ROWS
    MOVE WS-OPENING TO CTL-OPENING
    MOVE WS-CREDITS TO CTL-CREDITS
    MOVE WS-DEBITS TO CTL-DEBITS
    MOVE WS-INTEREST TO CTL-INTEREST
    MOVE WS-FINAL TO CTL-FINAL
    MOVE WS-EXPECTED TO CTL-EXPECTED
    IF WS-EXPECTED = WS-FINAL
        SET CTL-BALANCED TO TRUE
    ELSE
        SET CTL-OUT-OF-BAL TO TRUE
    END-IF
    OPEN OUTPUT CTL-OUT-FILE
    IF WS-CTL-OUT-STATUS NOT = "00"
        DISPLAY "CTLRPT: cannot open control.dat status="
            WS-CTL-OUT-STATUS
        STOP RUN
    END-IF
    WRITE CONTROL-RECORD
    CLOSE CTL-OUT-FILE.
