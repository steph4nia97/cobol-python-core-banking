>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. POSTTXN.
*> Post credits and debits against the account master.
*> Rejects unknown, closed, NSF, and invalid transactions.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ACCT-IN-FILE ASSIGN TO "accounts.in.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-ACCT-IN-STATUS.
    SELECT TXN-IN-FILE ASSIGN TO "transactions.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-TXN-IN-STATUS.
    SELECT ACCT-OUT-FILE ASSIGN TO "accounts.posted.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-ACCT-OUT-STATUS.
    SELECT EXC-OUT-FILE ASSIGN TO "exceptions.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-EXC-OUT-STATUS.

DATA DIVISION.
FILE SECTION.
FD ACCT-IN-FILE.
COPY ACCTREC.

FD TXN-IN-FILE.
COPY TXNREC.

FD ACCT-OUT-FILE.
    01 ACCT-OUT-RECORD           PIC X(61).

FD EXC-OUT-FILE.
COPY EXCREC.

WORKING-STORAGE SECTION.
01 WS-FILE-STATUS.
    05 WS-ACCT-IN-STATUS         PIC X(02).
    05 WS-TXN-IN-STATUS          PIC X(02).
    05 WS-ACCT-OUT-STATUS        PIC X(02).
    05 WS-EXC-OUT-STATUS         PIC X(02).

01 WS-FLAGS.
    05 WS-ACCT-EOF              PIC X VALUE "N".
        88 ACCT-EOF            VALUE "Y".
    05 WS-TXN-EOF               PIC X VALUE "N".
        88 TXN-EOF             VALUE "Y".
    05 WS-FOUND                 PIC X VALUE "N".
        88 ACCT-FOUND          VALUE "Y".

01 WS-ACCOUNT-TABLE.
    05 WS-ACCOUNT-COUNT         PIC 9(04) VALUE 0.
    05 WS-ACCT-ITEM OCCURS 200 TIMES INDEXED BY ACCT-IDX.
        10 WS-ACCT-BYTES        PIC X(61).

PROCEDURE DIVISION.
MAIN-PROCEDURE.
    PERFORM LOAD-ACCOUNTS
    PERFORM OPEN-OUTPUTS
    PERFORM POST-TRANSACTIONS
    PERFORM WRITE-ACCOUNTS
    PERFORM CLOSE-FILES
    STOP RUN.

LOAD-ACCOUNTS.
    OPEN INPUT ACCT-IN-FILE
    IF WS-ACCT-IN-STATUS NOT = "00"
        DISPLAY "POSTTXN: cannot open accounts.in.dat status="
            WS-ACCT-IN-STATUS
        STOP RUN
    END-IF
    PERFORM UNTIL ACCT-EOF
        READ ACCT-IN-FILE
            AT END
                SET ACCT-EOF TO TRUE
            NOT AT END
                ADD 1 TO WS-ACCOUNT-COUNT
                IF WS-ACCOUNT-COUNT > 200
                    DISPLAY "POSTTXN: account table overflow"
                    STOP RUN
                END-IF
                SET ACCT-IDX TO WS-ACCOUNT-COUNT
                MOVE ACCOUNT-RECORD TO WS-ACCT-BYTES(ACCT-IDX)
        END-READ
    END-PERFORM
    CLOSE ACCT-IN-FILE.

OPEN-OUTPUTS.
    OPEN OUTPUT ACCT-OUT-FILE
    IF WS-ACCT-OUT-STATUS NOT = "00"
        DISPLAY "POSTTXN: cannot open accounts.posted.dat status="
            WS-ACCT-OUT-STATUS
        STOP RUN
    END-IF
    OPEN OUTPUT EXC-OUT-FILE
    IF WS-EXC-OUT-STATUS NOT = "00"
        DISPLAY "POSTTXN: cannot open exceptions.dat status="
            WS-EXC-OUT-STATUS
        STOP RUN
    END-IF.

POST-TRANSACTIONS.
    OPEN INPUT TXN-IN-FILE
    IF WS-TXN-IN-STATUS NOT = "00"
        DISPLAY "POSTTXN: cannot open transactions.dat status="
            WS-TXN-IN-STATUS
        STOP RUN
    END-IF
    PERFORM UNTIL TXN-EOF
        READ TXN-IN-FILE
            AT END
                SET TXN-EOF TO TRUE
            NOT AT END
                PERFORM APPLY-ONE-TRANSACTION
        END-READ
    END-PERFORM
    CLOSE TXN-IN-FILE.

APPLY-ONE-TRANSACTION.
    PERFORM FIND-ACCOUNT
    IF NOT ACCT-FOUND
        MOVE "NFND" TO EXC-CODE
        MOVE "ACCOUNT NOT FOUND" TO EXC-MESSAGE
        PERFORM WRITE-EXCEPTION
        EXIT PARAGRAPH
    END-IF
    MOVE WS-ACCT-BYTES(ACCT-IDX) TO ACCOUNT-RECORD
    IF ACCT-CLOSED
        MOVE "CLSD" TO EXC-CODE
        MOVE "ACCOUNT IS CLOSED" TO EXC-MESSAGE
        PERFORM WRITE-EXCEPTION
        EXIT PARAGRAPH
    END-IF
    IF TXN-AMOUNT <= 0
        MOVE "IAMT" TO EXC-CODE
        MOVE "INVALID TRANSACTION AMOUNT" TO EXC-MESSAGE
        PERFORM WRITE-EXCEPTION
        EXIT PARAGRAPH
    END-IF
    IF TXN-CREDIT
        ADD TXN-AMOUNT TO ACCT-BALANCE
        MOVE ACCOUNT-RECORD TO WS-ACCT-BYTES(ACCT-IDX)
    ELSE
        IF TXN-DEBIT
            IF TXN-AMOUNT > ACCT-BALANCE
                MOVE "NSF " TO EXC-CODE
                MOVE "INSUFFICIENT FUNDS" TO EXC-MESSAGE
                PERFORM WRITE-EXCEPTION
            ELSE
                SUBTRACT TXN-AMOUNT FROM ACCT-BALANCE
                MOVE ACCOUNT-RECORD TO WS-ACCT-BYTES(ACCT-IDX)
            END-IF
        ELSE
            MOVE "ITYP" TO EXC-CODE
            MOVE "INVALID TRANSACTION TYPE" TO EXC-MESSAGE
            PERFORM WRITE-EXCEPTION
        END-IF
    END-IF.

FIND-ACCOUNT.
    MOVE "N" TO WS-FOUND
    PERFORM VARYING ACCT-IDX FROM 1 BY 1
        UNTIL ACCT-IDX > WS-ACCOUNT-COUNT
        IF WS-ACCT-BYTES(ACCT-IDX)(1:10) = TXN-ACCT-ID
            SET ACCT-FOUND TO TRUE
            EXIT PERFORM
        END-IF
    END-PERFORM.

WRITE-EXCEPTION.
    MOVE TXN-ACCT-ID TO EXC-ACCT-ID
    MOVE TXN-AMOUNT TO EXC-AMOUNT
    WRITE EXCEPTION-RECORD.

WRITE-ACCOUNTS.
    PERFORM VARYING ACCT-IDX FROM 1 BY 1
        UNTIL ACCT-IDX > WS-ACCOUNT-COUNT
        MOVE WS-ACCT-BYTES(ACCT-IDX) TO ACCT-OUT-RECORD
        WRITE ACCT-OUT-RECORD
    END-PERFORM.

CLOSE-FILES.
    CLOSE ACCT-OUT-FILE
    CLOSE EXC-OUT-FILE.
