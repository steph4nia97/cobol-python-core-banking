>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. POSTTXN.
*> Post credits and debits. Rejects NFND/CLSD/NSF/ITYP/IAMT/DUP.
*> Fatal I/O or overflow sets RETURN-CODE 8 so the orchestrator stops the stream.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ACCT-IN-FILE ASSIGN TO "accounts.in.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-ACCT-IN-STATUS.
    SELECT TXN-IN-FILE ASSIGN TO "transactions.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-TXN-IN-STATUS.
    SELECT PROC-IN-FILE ASSIGN TO "processed.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-PROC-IN-STATUS.
    SELECT ACCT-OUT-FILE ASSIGN TO "accounts.posted.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-ACCT-OUT-STATUS.
    SELECT EXC-OUT-FILE ASSIGN TO "exceptions.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-EXC-OUT-STATUS.
    SELECT JRN-OUT-FILE ASSIGN TO "journal.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-JRN-OUT-STATUS.

DATA DIVISION.
FILE SECTION.
FD ACCT-IN-FILE.
COPY ACCTREC.

FD TXN-IN-FILE.
COPY TXNREC.

FD PROC-IN-FILE.
    01 PROCESSED-ID-REC          PIC X(20).

FD ACCT-OUT-FILE.
    01 ACCT-OUT-RECORD           PIC X(61).

FD EXC-OUT-FILE.
COPY EXCREC.

FD JRN-OUT-FILE.
COPY JRNREC.

WORKING-STORAGE SECTION.
01 WS-FILE-STATUS.
    05 WS-ACCT-IN-STATUS         PIC X(02).
    05 WS-TXN-IN-STATUS          PIC X(02).
    05 WS-PROC-IN-STATUS         PIC X(02).
    05 WS-ACCT-OUT-STATUS        PIC X(02).
    05 WS-EXC-OUT-STATUS         PIC X(02).
    05 WS-JRN-OUT-STATUS        PIC X(02).

01 WS-FLAGS.
    05 WS-ACCT-EOF              PIC X VALUE "N".
        88 ACCT-EOF            VALUE "Y".
    05 WS-TXN-EOF               PIC X VALUE "N".
        88 TXN-EOF             VALUE "Y".
    05 WS-PROC-EOF              PIC X VALUE "N".
        88 PROC-EOF            VALUE "Y".
    05 WS-FOUND                 PIC X VALUE "N".
        88 ACCT-FOUND          VALUE "Y".
    05 WS-DUP                   PIC X VALUE "N".
        88 TXN-DUPLICATE      VALUE "Y".

01 WS-ACCOUNT-TABLE.
    05 WS-ACCOUNT-COUNT         PIC 9(04) VALUE 0.
    05 WS-ACCT-ITEM OCCURS 200 TIMES INDEXED BY ACCT-IDX.
        10 WS-ACCT-BYTES        PIC X(61).

01 WS-PROCESSED-TABLE.
    05 WS-PROC-COUNT            PIC 9(04) VALUE 0.
    05 WS-PROC-ID OCCURS 500 TIMES INDEXED BY PROC-IDX.
        10 WS-PROC-BYTES        PIC X(20).

01 WS-BAL-BEFORE                 PIC S9(11)V99 SIGN IS LEADING SEPARATE.

PROCEDURE DIVISION.
MAIN-PROCEDURE.
    PERFORM LOAD-ACCOUNTS
    PERFORM LOAD-PROCESSED
    PERFORM OPEN-OUTPUTS
    PERFORM POST-TRANSACTIONS
    PERFORM WRITE-ACCOUNTS
    PERFORM CLOSE-FILES
    STOP RUN.

ABEND-8.
    MOVE 8 TO RETURN-CODE
    STOP RUN.

LOAD-ACCOUNTS.
    OPEN INPUT ACCT-IN-FILE
    IF WS-ACCT-IN-STATUS NOT = "00"
        DISPLAY "POSTTXN: cannot open accounts.in.dat"
        PERFORM ABEND-8
    END-IF
    PERFORM UNTIL ACCT-EOF
        READ ACCT-IN-FILE
            AT END
                SET ACCT-EOF TO TRUE
            NOT AT END
                ADD 1 TO WS-ACCOUNT-COUNT
                IF WS-ACCOUNT-COUNT > 200
                    DISPLAY "POSTTXN: account table overflow"
                    PERFORM ABEND-8
                END-IF
                SET ACCT-IDX TO WS-ACCOUNT-COUNT
                MOVE ACCOUNT-RECORD TO WS-ACCT-BYTES(ACCT-IDX)
        END-READ
    END-PERFORM
    CLOSE ACCT-IN-FILE.

LOAD-PROCESSED.
    OPEN INPUT PROC-IN-FILE
    IF WS-PROC-IN-STATUS = "35"
        EXIT PARAGRAPH
    END-IF
    IF WS-PROC-IN-STATUS NOT = "00"
        DISPLAY "POSTTXN: cannot open processed.dat"
        PERFORM ABEND-8
    END-IF
    PERFORM UNTIL PROC-EOF
        READ PROC-IN-FILE
            AT END
                SET PROC-EOF TO TRUE
            NOT AT END
                ADD 1 TO WS-PROC-COUNT
                IF WS-PROC-COUNT > 500
                    DISPLAY "POSTTXN: processed-id table overflow"
                    PERFORM ABEND-8
                END-IF
                SET PROC-IDX TO WS-PROC-COUNT
                MOVE PROCESSED-ID-REC TO WS-PROC-BYTES(PROC-IDX)
        END-READ
    END-PERFORM
    CLOSE PROC-IN-FILE.

OPEN-OUTPUTS.
    OPEN OUTPUT ACCT-OUT-FILE
    IF WS-ACCT-OUT-STATUS NOT = "00"
        DISPLAY "POSTTXN: cannot open accounts.posted.dat"
        PERFORM ABEND-8
    END-IF
    OPEN OUTPUT EXC-OUT-FILE
    IF WS-EXC-OUT-STATUS NOT = "00"
        DISPLAY "POSTTXN: cannot open exceptions.dat"
        PERFORM ABEND-8
    END-IF
    OPEN OUTPUT JRN-OUT-FILE
    IF WS-JRN-OUT-STATUS NOT = "00"
        DISPLAY "POSTTXN: cannot open journal.dat"
        PERFORM ABEND-8
    END-IF.

POST-TRANSACTIONS.
    OPEN INPUT TXN-IN-FILE
    IF WS-TXN-IN-STATUS NOT = "00"
        DISPLAY "POSTTXN: cannot open transactions.dat"
        PERFORM ABEND-8
    END-IF
    PERFORM UNTIL TXN-EOF
        READ TXN-IN-FILE
            AT END
                SET TXN-EOF TO TRUE
            NOT AT END
                PERFORM APPLY-ONE-TRANSACTION
        END-READ
    END-PERFORM
    CLOSE TXN-IN-FILE.

APPLY-ONE-TRANSACTION.
    PERFORM CHECK-DUPLICATE
    IF TXN-DUPLICATE
        MOVE "DUP " TO EXC-CODE
        MOVE "ALREADY PROCESSED" TO EXC-MESSAGE
        PERFORM WRITE-EXCEPTION
        EXIT PARAGRAPH
    END-IF
    PERFORM FIND-ACCOUNT
    IF NOT ACCT-FOUND
        MOVE "NFND" TO EXC-CODE
        MOVE "ACCOUNT NOT FOUND" TO EXC-MESSAGE
        PERFORM WRITE-EXCEPTION
        EXIT PARAGRAPH
    END-IF
    MOVE WS-ACCT-BYTES(ACCT-IDX) TO ACCOUNT-RECORD
    IF ACCT-CLOSED
        MOVE "CLSD" TO EXC-CODE
        MOVE "ACCOUNT IS CLOSED" TO EXC-MESSAGE
        PERFORM WRITE-EXCEPTION
        EXIT PARAGRAPH
    END-IF
    IF TXN-AMOUNT <= 0
        MOVE "IAMT" TO EXC-CODE
        MOVE "INVALID TRANSACTION AMOUNT" TO EXC-MESSAGE
        PERFORM WRITE-EXCEPTION
        EXIT PARAGRAPH
    END-IF
    IF TXN-CREDIT
        MOVE ACCT-BALANCE TO WS-BAL-BEFORE
        ADD TXN-AMOUNT TO ACCT-BALANCE
        MOVE ACCOUNT-RECORD TO WS-ACCT-BYTES(ACCT-IDX)
        PERFORM WRITE-JOURNAL
        PERFORM REMEMBER-TXN-ID
    ELSE
        IF TXN-DEBIT
            IF TXN-AMOUNT > ACCT-BALANCE
                MOVE "NSF " TO EXC-CODE
                MOVE "INSUFFICIENT FUNDS" TO EXC-MESSAGE
                PERFORM WRITE-EXCEPTION
            ELSE
                MOVE ACCT-BALANCE TO WS-BAL-BEFORE
                SUBTRACT TXN-AMOUNT FROM ACCT-BALANCE
                MOVE ACCOUNT-RECORD TO WS-ACCT-BYTES(ACCT-IDX)
                PERFORM WRITE-JOURNAL
                PERFORM REMEMBER-TXN-ID
            END-IF
        ELSE
            MOVE "ITYP" TO EXC-CODE
            MOVE "INVALID TRANSACTION TYPE" TO EXC-MESSAGE
            PERFORM WRITE-EXCEPTION
        END-IF
    END-IF.

CHECK-DUPLICATE.
    MOVE "N" TO WS-DUP
    PERFORM VARYING PROC-IDX FROM 1 BY 1
        UNTIL PROC-IDX > WS-PROC-COUNT
        IF WS-PROC-BYTES(PROC-IDX) = TXN-ID
            SET TXN-DUPLICATE TO TRUE
            EXIT PERFORM
        END-IF
    END-PERFORM.

REMEMBER-TXN-ID.
    ADD 1 TO WS-PROC-COUNT
    IF WS-PROC-COUNT > 500
        DISPLAY "POSTTXN: processed-id table overflow"
        PERFORM ABEND-8
    END-IF
    SET PROC-IDX TO WS-PROC-COUNT
    MOVE TXN-ID TO WS-PROC-BYTES(PROC-IDX).

FIND-ACCOUNT.
    MOVE "N" TO WS-FOUND
    PERFORM VARYING ACCT-IDX FROM 1 BY 1
        UNTIL ACCT-IDX > WS-ACCOUNT-COUNT
        IF WS-ACCT-BYTES(ACCT-IDX)(1:10) = TXN-ACCT-ID
            SET ACCT-FOUND TO TRUE
            EXIT PERFORM
        END-IF
    END-PERFORM.

WRITE-EXCEPTION.
    MOVE TXN-ID TO EXC-TXN-ID
    MOVE TXN-ACCT-ID TO EXC-ACCT-ID
    MOVE TXN-AMOUNT TO EXC-AMOUNT
    WRITE EXCEPTION-RECORD.

WRITE-JOURNAL.
    MOVE TXN-ID TO JRN-TXN-ID
    MOVE TXN-ACCT-ID TO JRN-ACCT-ID
    MOVE TXN-DATE TO JRN-DATE
    MOVE TXN-TYPE TO JRN-TYPE
    MOVE TXN-AMOUNT TO JRN-AMOUNT
    MOVE WS-BAL-BEFORE TO JRN-BAL-BEFORE
    MOVE ACCT-BALANCE TO JRN-BAL-AFTER
    MOVE TXN-DESC TO JRN-DESC
    WRITE JOURNAL-RECORD.

WRITE-ACCOUNTS.
    PERFORM VARYING ACCT-IDX FROM 1 BY 1
        UNTIL ACCT-IDX > WS-ACCOUNT-COUNT
        MOVE WS-ACCT-BYTES(ACCT-IDX) TO ACCT-OUT-RECORD
        WRITE ACCT-OUT-RECORD
    END-PERFORM.

CLOSE-FILES.
    CLOSE ACCT-OUT-FILE
    CLOSE EXC-OUT-FILE
    CLOSE JRN-OUT-FILE.
