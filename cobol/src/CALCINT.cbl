>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. CALCINT.
*> Apply monthly interest to active savings accounts.
*> Interest = balance * annual-rate / 12, rounded to cents.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ACCT-IN-FILE ASSIGN TO "accounts.posted.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-ACCT-IN-STATUS.
    SELECT ACCT-OUT-FILE ASSIGN TO "accounts.final.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-ACCT-OUT-STATUS.
    SELECT INT-OUT-FILE ASSIGN TO "interest.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-INT-OUT-STATUS.

DATA DIVISION.
FILE SECTION.
FD ACCT-IN-FILE.
COPY ACCTREC.

FD ACCT-OUT-FILE.
    01 ACCT-OUT-RECORD           PIC X(61).

FD INT-OUT-FILE.
COPY INTREC.

WORKING-STORAGE SECTION.
01 WS-FILE-STATUS.
    05 WS-ACCT-IN-STATUS         PIC X(02).
    05 WS-ACCT-OUT-STATUS        PIC X(02).
    05 WS-INT-OUT-STATUS         PIC X(02).

01 WS-FLAGS.
    05 WS-ACCT-EOF              PIC X VALUE "N".
        88 ACCT-EOF            VALUE "Y".

01 WS-INTEREST                  PIC S9(09)V99 SIGN IS LEADING SEPARATE.
01 WS-MONTHS                    PIC 9(02) VALUE 12.

PROCEDURE DIVISION.
MAIN-PROCEDURE.
    OPEN INPUT ACCT-IN-FILE
    IF WS-ACCT-IN-STATUS NOT = "00"
        DISPLAY "CALCINT: cannot open accounts.posted.dat"
        MOVE 8 TO RETURN-CODE
        STOP RUN
    END-IF
    OPEN OUTPUT ACCT-OUT-FILE
    IF WS-ACCT-OUT-STATUS NOT = "00"
        DISPLAY "CALCINT: cannot open accounts.final.dat"
        MOVE 8 TO RETURN-CODE
        STOP RUN
    END-IF
    OPEN OUTPUT INT-OUT-FILE
    IF WS-INT-OUT-STATUS NOT = "00"
        DISPLAY "CALCINT: cannot open interest.dat"
        MOVE 8 TO RETURN-CODE
        STOP RUN
    END-IF
    PERFORM UNTIL ACCT-EOF
        READ ACCT-IN-FILE
            AT END
                SET ACCT-EOF TO TRUE
            NOT AT END
                PERFORM APPLY-INTEREST
                MOVE ACCOUNT-RECORD TO ACCT-OUT-RECORD
                WRITE ACCT-OUT-RECORD
        END-READ
    END-PERFORM
    CLOSE ACCT-IN-FILE
    CLOSE ACCT-OUT-FILE
    CLOSE INT-OUT-FILE
    STOP RUN.

APPLY-INTEREST.
    MOVE 0 TO WS-INTEREST
    IF ACCT-SAVINGS AND ACCT-ACTIVE
        COMPUTE WS-INTEREST ROUNDED = ACCT-BALANCE * ACCT-RATE / WS-MONTHS
        ADD WS-INTEREST TO ACCT-BALANCE
        MOVE ACCT-ID TO INT-ACCT-ID
        MOVE WS-INTEREST TO INT-AMOUNT
        WRITE INTEREST-RECORD
    END-IF.
